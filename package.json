{
  "name": "templates",
  "description": "Six landing pages in one Qwik app, each driven by a different scroll toolset.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Static output is in dist/ — upload it to any static host.'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "build.server": "vite build -c adapters/static/vite.config.ts",
    "build.static": "npm run build.client && npm run build.server",
    "serve": "npx --yes serve dist",
    "previews": "node scripts/capture-previews.mjs"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@eslint/js": "^9",
    "@types/matter-js": "^0.20.2",
    "@types/node": "20.19.0",
    "@types/three": "^0.185.4",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "^1.20.0",
    "ffmpeg-static": "^5.3.0",
    "globals": "16.4.0",
    "playwright-core": "^1.63.0",
    "prettier": "3.6.2",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "typescript-plugin-css-modules": "latest",
    "undici": "^7.16.0",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "^4.2.1"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "matter-js": "^0.20.0",
    "motion": "^13.2.0",
    "three": "^0.186.0"
  }
}
